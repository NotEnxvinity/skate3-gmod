+
+/// Names every non-finite packet lane and the values the launch read, so a
+/// glitched ride's console line shows where the launch went wrong.
+fn launch_report(
+    packet: &skate_core::player::offboard::air_launch::Packet,
+    input: &sync::LaunchInput,
+    state: &skate_core::player::offboard::controller::State,
+) -> String {
+    let fields = [
+        ("velocity_0", packet.velocity_0),
+        ("secondary_16", packet.secondary_velocity_16),
+        ("position_32", packet.position_32),
+        ("up_48", packet.up_48),
+        ("forward_64", packet.forward_64),
+        ("board_80", packet.board_position_80),
+    ];
+    let mut bad = Vec::new();
+    for (name, v) in fields {
+        for (lane, x) in v.iter().enumerate() {
+            if !x.is_finite() {
+                bad.push(format!("{name}.{}", ["x", "y", "z", "w"][lane]));
+            }
+        }
+    }
+    for (name, x) in [("s96", packet.scalar_96), ("s100", packet.scalar_100), ("s104", packet.scalar_104)] {
+        if !x.is_finite() {
+            bad.push(name.to_owned());
+        }
+    }
+    let p = &input.processed;
+    format!(
+        "bad {}; mode {}; packet {:?}; processed {:?}; elapsed {}; com {:?}; ref_up {:?}; motion_up {:?}; spin {} speed {} steer {} contact {}",
+        bad.join(","),
+        skate_core::player::offboard::air_launch::mode(p, false),
+        packet,
+        p,
+        input.elapsed_2664,
+        input.skeleton_point_10960,
+        state.frame_output.frame[1],
+        state.motion.frame_0[1],
+        state.motion.angular_velocity_688,
+        state.motion.speed_704,
+        state.intent.steering,
+        state.contact.active,
+    )
+}
