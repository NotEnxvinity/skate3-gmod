index 98afc5f..1097a70 100644
--- a/skate/crates/skate-host/src/physics/bridge.rs
+++ b/skate/crates/skate-host/src/physics/bridge.rs
@@ -41,6 +41,21 @@ pub struct Score {
     pub fakie: bool,
     /// Riding with the opposite foot forward from the natural stance.
     pub switch: bool,
+    /// The latest jump's spin in half turns, rounded the way the scoring
+    /// does (its tolerance short of each 180), signed by the board's heading:
+    /// positive turns counter-clockwise seen from above. Held after landing
+    /// until the next jump.
+    pub spin: i32,
+    /// Counts jumps; goes up as each one leaves the ground.
+    pub jump: u32,
+    /// Whether the skater is in the air now.
+    pub air: bool,
+    /// The stance the latest jump left the ground in.
+    pub takeoff_fakie: bool,
+    pub takeoff_switch: bool,
+    /// Counts tricks the scoring has announced, so the same trick twice in a
+    /// row still reads as two.
+    pub tricks: u32,
 }
 pub struct Pose {
     pub root: Mat4,
