+++ b/skate/crates/skate-host/src/hall_of_meat.rs
@@ -0,0 +1,35 @@
+//! Hall of Meat for a host that scores it itself (S3GM): the original's mode
+//! switch (game settings +184) and the broken-bone duration Scoring2 keeps at
+//! +200, which the camera reads for its broken-bone slow motion and shake.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+/// Camera publications the current broken bone still lasts.
+static BROKEN: AtomicU32 = AtomicU32::new(0);
+
+pub fn set_enabled(on: bool) {
+    ENABLED.store(on, Ordering::Relaxed);
+    if !on {
+        BROKEN.store(0, Ordering::Relaxed);
+    }
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// A bone just broke: the camera's broken-bone shot runs for `ticks`.
+pub fn break_bone(ticks: u32) {
+    if enabled() {
+        BROKEN.store(ticks, Ordering::Relaxed);
+    }
+}
+
+/// Seconds left on the broken bone, counting one tick down per call.
+pub(crate) fn broken_duration() -> f32 {
+    let left = BROKEN
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| n.checked_sub(1))
+        .unwrap_or(0);
+    left as f32 / 60.0
+}
