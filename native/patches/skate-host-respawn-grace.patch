diff --git a/skate/crates/skate-core/src/player/wipeout/tests.rs b/skate/crates/skate-core/src/player/wipeout/tests.rs
index de44044..96e60a3 100644
--- a/skate/crates/skate-core/src/player/wipeout/tests.rs
+++ b/skate/crates/skate-core/src/player/wipeout/tests.rs
@@ -248,3 +248,21 @@ fn wipeout_ground_animation_keeps_additional_checks_during_cooldown() {
     assert!(state.reasons[0]);
     assert!(!state.reasons[20]);
 }
+
+#[test]
+fn respawn_grace_blocks_every_bail_for_a_fifth_of_a_second() {
+    let mut state = Requests::new();
+    state.start_grace();
+    state.request(24, 0.0); //A landing bail, which no cooldown covers.
+    assert!(!state.requests_wipeout(&request_input()));
+    state.tick_grace(0.1);
+    state.request(15, 1.0);
+    assert!(!state.requests_wipeout(&request_input()));
+    assert_eq!(state.count, 1);
+    state.tick_grace(0.1); //Requests made during the grace are dropped.
+    assert_eq!(state.count, 0);
+    assert!(state.grace <= 0.0);
+    assert!(!state.requests_wipeout(&request_input()));
+    state.request(24, 0.0);
+    assert!(state.requests_runout(&request_input()) || state.requests_wipeout(&request_input()));
+}
