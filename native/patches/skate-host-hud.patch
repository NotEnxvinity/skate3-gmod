+    /// The line in progress as a score HUD shows it.
+    pub(crate) fn hud(&self) -> crate::physics::bridge::Score {
+        let session = &self.session;
+        let capacity = self.data.session_rules().line_capacity;
+        crate::physics::bridge::Score {
+            trick: self.trick_name.clone(),
+            sequence: self.sequence_score,
+            line: session.holder.snapshot.line,
+            banked: session.holder.snapshot.completed_lines,
+            multiplier: session.combo.multiplier,
+            line_timer: if capacity > 0. {
+                (session.line.points / capacity).clamp(0., 1.)
+            } else {
+                0.
+            },
+            active: self.sequence_active,
+        }
+    }
